# =============================================================================
# Memoli Web – environment variables
# Copy to .env and fill in your values. Never commit .env or secrets.
# =============================================================================

# Turnstile (captcha for beta signup)
# Get keys: https://dash.cloudflare.com → Turnstile → Add site
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Beta signup – webhook URL (POST { email, name?, message?, turnstile_token? })
NEXT_PUBLIC_N8N_BETA_WEBHOOK_URL=

# Beta signup – optional API key header
NEXT_PUBLIC_BETA_SIGNUP_API_KEY=

# =============================================================================
# Decap CMS Backend Server Configuration
# =============================================================================

# Admin server port (runs on separate from Next.js app)
ADMIN_PORT=8081

# Git configuration for CMS content changes
GIT_BRANCH=main
GIT_AUTHOR_NAME=Memoli CMS
GIT_AUTHOR_EMAIL=cms@memoli.app

# Optional: Git remote for pushing CMS changes
# GIT_REMOTE_URL=https://github.com/your-org/memoli-web.git
# GIT_TOKEN=your_github_token_here
# GIT_SSH_KEY_PATH=/path/to/ssh/key

# Automatically commit and push CMS changes to git
GIT_COMMIT_ON_DEPLOY=false

# Preview and production URLs
PREVIEW_URL=http://localhost:3000
PRODUCTION_URL=https://memoli.app
