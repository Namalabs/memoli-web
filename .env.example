# =============================================================================
# Memoli Web – environment variables
# Copy to .env.local and fill in your values. Never commit .env.local or secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Cloudflare Turnstile (captcha for beta signup)
# Get keys: https://dash.cloudflare.com → Turnstile → Add site
# -----------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Beta signup – endpoint URL (client calls this directly; for static deployment)
# POST body: { email, name?, message?, turnstile_token? }
# -----------------------------------------------------------------------------
NEXT_PUBLIC_N8N_BETA_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# Beta signup – optional header x-api-key for your API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_BETA_SIGNUP_API_KEY=

# Ghost CMS
NEXT_PUBLIC_GHOST_API_KEY=your_key_here

# Local Phase
NEXT_PUBLIC_GHOST_API_URL=http://localhost:3001

# # Managed Phase (just change URL, same API)
# NEXT_PUBLIC_GHOST_API_URL=https://ghost.memoli.com