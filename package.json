{
  "name": "memoli-nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/build-blog-json.mjs && next dev --webpack",
    "dev:cms": "node server.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:cms\"",
    "build": "node scripts/build-blog-json.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "lottie:optimize": "node scripts/optimize-lottie-images.mjs --in-place",
    "images:webp": "node scripts/convert-images-to-webp.mjs",
    "images:webp:replace": "node scripts/convert-images-to-webp.mjs --replace"
  },
  "dependencies": {
    "@lottiefiles/dotlottie-react": "^0.18.3",
    "gray-matter": "^4.0.3",
    "gsap": "^3.14.2",
    "markdown-it": "^14.2.0",
    "netlify-cms-proxy-server": "^1.3.24",
    "next": "16.1.6",
    "next-turnstile": "^1.0.7",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@dotlottie/dotlottie-js": "^1.6.3",
    "@tailwindcss/postcss": "^4",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^10.0.3",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "express": "^5.2.1",
    "sharp": "^0.33.5",
    "sqlite3": "^5.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
